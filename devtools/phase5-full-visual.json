  "name": "exec",
  "arguments": {
   "action": "game",
   "code": "scene.ui.close()\nvar w=scene.world\nvar target=-1\nvar forest=-1\nvar score=INF\nfor i in range(w.cells.size()):\n\tif w.settlements.any(func(home): return absf(w.cells[int(home.cell)].x-w.cells[i].x)+absf(w.cells[int(home.cell)].y-w.cells[i].y)<3): continue\n\tfor j in range(w.cells.size()):\n\t\tif i==j or w.cells[i].biome==6 or w.cells[j].biome==6: continue\n\t\tif absf(w.cells[i].x-w.cells[j].x)+absf(w.cells[i].y-w.cells[j].y)!=1: continue\n\t\tvar d=scene.view.project(w.cells[i]).length()\n\t\tif d<score: score=d; target=i; forest=j\nif target>=0:\n\tPowers.apply(w,1,forest)\n\tscene.view.invalidate()\n\tscene.view.selected=target\n\tscene.view.pan=-scene.view.project(w.cells[target])*.88\n\tscene.view.zoom=.88\n\tscene.ui.choose_power(2)\nreturn {\"mountain_target\":target,\"forest\":forest}"
  }
 },
